// Copy to ios/Flutter/Secrets.xcconfig (git-ignored) and fill in the iOS
// Google Maps SDK key. CI writes the same file from a repository secret:
//   printf 'GOOGLE_MAPS_API_KEY = %s\n' "$GOOGLE_MAPS_IOS_API_KEY" > ios/Flutter/Secrets.xcconfig
// Info.plist exposes it as GMSApiKey, which AppDelegate passes to
// GMSServices. Without it Debug builds show the no-map fallback and
// Release/Profile builds fail in the "Check Google Maps key" build phase.
GOOGLE_MAPS_API_KEY = 
